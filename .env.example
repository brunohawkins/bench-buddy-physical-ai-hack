# Copy to .env (git-ignored) and fill in.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SERIAL_PORT=/dev/cu.usbmodem1101   # ls /dev/cu.usb* with the Arduino plugged in
CAMERA_SOURCE=0                    # camera index, or the Jetson stream URL
CAMERA_WIDTH=3840                  # requests 4K; device may negotiate a lower resolution
CAMERA_HEIGHT=2160
VOICE_BARGE_IN=1                   # macOS echo-cancelled interruption; 0 uses the original half-duplex audio
